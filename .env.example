# Copy this file to .env and fill it in. .env is git-ignored: never commit real passwords or keys.

# MySQL (the database and table are created by `npm start` / `npm run seed` if missing)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=insta_post

# Optional: an Imgur app's Client ID (https://api.imgur.com/oauth2/addclient).
# Without it, uploaded images are kept in public/uploads on this server.
IMGUR_CLIENT_ID=

PORT=8080
