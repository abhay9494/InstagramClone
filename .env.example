# Copy this file to .env and fill it in. .env is git-ignored: never commit real passwords or keys.
# (No database? Run `npm run demo` instead of `npm start`; it needs no settings at all.)

# MySQL (the database and tables are created by `npm start` / `npm run seed` if missing)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=insta_post

# Signs the login cookies. Use a long random string, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it everyone is logged out whenever the server restarts.
SESSION_SECRET=

# Optional: an Imgur app's Client ID (https://api.imgur.com/oauth2/addclient).
# Without it, uploaded photos are kept in public/uploads on this server.
IMGUR_CLIENT_ID=

PORT=8080
