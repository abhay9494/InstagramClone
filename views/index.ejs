<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style.css" />
    <title>Instagram — Posts</title>
</head>

<body>
    <header>
        <img src="/logo.svg" alt="Insta Logo">
        <h1 id="insta_name">Instagram</h1>
    </header>

    <main>
        <div class="toolbar">
            <span class="count"><%= total %> posts</span>
            <a href="/posts/new" id="addPost">Write a new post</a>
        </div>

        <% if (!results.length) { %>
            <p class="empty">No posts yet. Write the first one, or run <code>npm run seed</code> to add 500 sample posts.</p>
        <% } %>

        <div class="container">
            <% for (const post of results) { %>
                <div class="post">
                    <div class="post_head">
                        <img class="profile_pic" src="https://i.pinimg.com/564x/8a/01/cc/8a01cc0579be056ecc8dfa2f07bd42aa.jpg" alt="">
                        <div class="user_info">
                            <p class="username"><%= post.username %></p>
                            <p class="name"><%= post.name %></p>
                        </div>
                    </div>

                    <a href="/posts/<%= post.id %>" class="image" style="background-image: url('<%= post.image %>');" aria-label="Open the post"></a>
                    <p class="comment"><%= post.comment %></p>
                    <div id="buttons">
                        <a href="/posts/<%= post.id %>/edit" id="edit_button">Edit Post</a>
                        <form method="post" action="/posts/<%= post.id %>?_method=DELETE">
                            <button id="delete_btn">Delete Post</button>
                        </form>
                    </div>
                </div>
            <% } %>
        </div>

        <% if (pages > 1) { %>
            <nav class="pages">
                <% if (page > 1) { %><a href="/?page=<%= page - 1 %>">‹ Newer</a><% } %>
                <span>Page <%= page %> of <%= pages %></span>
                <% if (page < pages) { %><a href="/?page=<%= page + 1 %>">Older ›</a><% } %>
            </nav>
        <% } %>
    </main>

</body>

</html>
