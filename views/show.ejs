<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style.css" />
    <title><%= post.username %> — Instagram</title>
</head>

<body>
    <header>
        <img src="/logo.svg" alt="Insta Logo">
        <h1 id="insta_name">Instagram</h1>
    </header>

    <main id="main_body">
        <div class="post single">
            <div class="post_head">
                <img class="profile_pic" src="https://i.pinimg.com/564x/8a/01/cc/8a01cc0579be056ecc8dfa2f07bd42aa.jpg" alt="">
                <div class="user_info">
                    <p class="username"><%= post.username %></p>
                    <p class="name"><%= post.name %></p>
                </div>
            </div>
            <div class="image" style="background-image: url('<%= post.image %>');"></div>
            <p class="comment"><%= post.comment %></p>
            <div id="buttons">
                <a href="/posts/<%= post.id %>/edit" id="edit_button">Edit Post</a>
                <form method="post" action="/posts/<%= post.id %>?_method=DELETE">
                    <button id="delete_btn">Delete Post</button>
                </form>
            </div>
        </div>
        <p><a href="/" class="back">‹ All posts</a></p>
    </main>

</body>

</html>
