<a class="tile" href="/p/<%= post.id %>" data-modal>
  <% if (post.image) { %>
    <img src="<%= post.image %>" alt="<%= altOf(post) %>" class="f-<%= post.filter %>" loading="lazy" decoding="async">
  <% } else if (post.video) { %>
    <video src="<%= post.video %>#t=0.1" class="f-<%= post.filter %>" muted playsinline preload="metadata" aria-label="<%= altOf(post) %>"></video>
  <% } %>
  <% if (post.kind === "reel" && locals.layout !== "reels") { %><span class="tile-kind" aria-label="Reel"><%- icon("reels", { size: 20 }) %></span><% } %>
  <% if (post.kind === "reel" && locals.layout === "reels") { %><span class="tile-views"><%- icon("play", { size: 14 }) %><%= compact(post.views) %></span><% } %>
  <span class="tile-stats" aria-hidden="true">
    <span><%- icon("heart-on", { size: 19 }) %><%= compact(post.like_count) %></span>
    <span><%- icon("comment-on", { size: 19 }) %><%= compact(post.comment_count) %></span>
  </span>
</a>
