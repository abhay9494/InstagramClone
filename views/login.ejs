<%- include("partials/head", { bodyClass: "auth-page" }) %>
<main id="main" class="auth">
  <div class="phone" aria-hidden="true">
    <div class="phone-screen">
      <div class="phone-bar"><span class="wordmark">Instagram</span><span class="phone-icons"><%- icon("heart", { size: 18 }) %><%- icon("share", { size: 18 }) %></span></div>
      <div class="phone-stories"><% for (let i = 0; i < 5; i++) { %><span class="ring<%= i > 2 ? ' seen' : '' %>"><span class="phone-dot"></span></span><% } %></div>
      <div class="phone-shots" data-phone-shots>
        <% photos.forEach((src, i) => { %><img src="<%= src %>" alt="" class="<%= i === 0 ? 'on' : '' %>"><% }) %>
      </div>
      <div class="phone-actions"><%- icon("heart-on", { size: 18 }) %><%- icon("comment", { size: 18 }) %><%- icon("share", { size: 18 }) %><span class="push"><%- icon("save", { size: 18 }) %></span></div>
      <div class="phone-lines"><span></span><span></span><span></span></div>
    </div>
  </div>
  <div class="auth-col">
    <div class="auth-box">
      <h1 class="wordmark auth-logo">Instagram</h1>
      <form method="post" action="/login" class="auth-form">
        <input type="hidden" name="next" value="<%= next %>">
        <label class="float"><input name="username" value="<%= username %>" placeholder=" " required autocomplete="username" autocapitalize="none" spellcheck="false"><span>Username</span></label>
        <label class="float"><input type="password" name="password" placeholder=" " required autocomplete="current-password"><span>Password</span><button type="button" class="show-password" data-show-password hidden>Show</button></label>
        <button class="btn btn-block">Log in</button>
      </form>
      <% if (error) { %><p class="form-error" role="alert"><%= error %></p><% } %>
      <% if (demo) { %>
        <div class="or"><span>OR</span></div>
        <form method="post" action="/login">
          <input type="hidden" name="username" value="<%= demo.username %>">
          <input type="hidden" name="password" value="<%= demo.password %>">
          <input type="hidden" name="next" value="<%= next %>">
          <button class="link-btn demo-login"><%- icon("user", { size: 18 }) %>Log in with the demo account</button>
        </form>
      <% } %>
    </div>
    <div class="auth-box alt">Don't have an account? <a href="/signup" class="strong-link">Sign up</a></div>
  </div>
</main>
<footer class="auth-footer muted">
  <p><a href="https://github.com/abhay9494/InstagramClone">About this project</a> · <a href="/explore">Explore</a> · No ads, no tracking</p>
  <p>© 2026 Instagram clone</p>
</footer>
<%- include("partials/end") %>
